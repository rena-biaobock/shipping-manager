# Backend — OpenEdge PASOE (docker-compose environment)
OE_CORS_ORIGINS=http://localhost
OE_JWT_SECRET=changeme
OE_DB_PATH=/data/shipping_manager
OE_IDLE_THRESHOLD_DAYS=30

# Frontend — Webpack build (frontend/.env)
# Use a relative path so nginx proxies correctly in Docker;
# use the full URL (http://localhost:8080/web/api/v1) for local npm start.
API_BASE_URL=/web/api/v1
