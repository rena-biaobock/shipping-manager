FROM node:24-slim

RUN apt-get update && apt-get install -y \
    chromium \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
RUN npm install

COPY . .

# Tell karma-chrome-launcher where Chromium lives inside this image
ENV CHROMIUM_BIN=/usr/bin/chromium

CMD ["npm", "test"]
