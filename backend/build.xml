<?xml version="1.0" encoding="UTF-8"?>
<project name="shipping-manager-backend" default="compile" basedir=".">

  <description>Ant build for the shipping-manager Progress ABL back-end.</description>

  <!-- ── properties ───────────────────────────────────────────────── -->
  <property name="src.dir"       value="${basedir}/src"/>
  <property name="tests.dir"     value="${basedir}/tests"/>
  <property name="build.dir"     value="${basedir}/build"/>
  <property name="schema.dir"    value="${basedir}/schema"/>
  <property name="conf.dir"      value="${basedir}/conf"/>

  <!-- OpenEdge install directory — set DLC env var or override here -->
  <property environment="env"/>
  <property name="dlc"           value="${env.DLC}"/>
  <property name="propath"       value="${src.dir}:${tests.dir}:${dlc}/tty/netlib/OpenEdge.Net.pl:${dlc}/gui/netlib/OpenEdge.Web.pl"/>

  <!-- ── taskdefs ─────────────────────────────────────────────────── -->
  <taskdef resource="PCT/pct.properties"
           classpath="${dlc}/pct/PCT.jar"/>

  <!-- ── targets ──────────────────────────────────────────────────── -->

  <target name="init">
    <mkdir dir="${build.dir}"/>
  </target>

  <target name="compile" depends="init" description="Compile all ABL classes">
    <PCTCompile destDir="${build.dir}" propath="${propath}" graphicalMode="false">
      <fileset dir="${src.dir}" includes="**/*.cls,**/*.p"/>
    </PCTCompile>
  </target>

  <target name="compile-tests" depends="compile" description="Compile ABLUnit test classes">
    <PCTCompile destDir="${build.dir}" propath="${build.dir}:${propath}" graphicalMode="false">
      <fileset dir="${tests.dir}" includes="**/*.cls"/>
    </PCTCompile>
  </target>

  <target name="test" depends="compile-tests" description="Run ABLUnit test suite">
    <ABLUnit destDir="${build.dir}/test-results"
             propath="${build.dir}:${propath}"
             writeLog="true"
             graphicalMode="false">
      <fileset dir="${tests.dir}/unit" includes="*.cls"/>
    </ABLUnit>
  </target>

  <target name="lint" description="Run ABLint static analysis">
    <exec executable="${dlc}/bin/abl-linter" failonerror="true">
      <arg value="--src"/>
      <arg value="${src.dir}"/>
      <arg value="--config"/>
      <arg value="${basedir}/.ablint.json"/>
    </exec>
  </target>

  <target name="start-pasoe" description="Start PASOE in development mode">
    <exec executable="${dlc}/bin/tcman" failonerror="true">
      <arg value="start"/>
      <arg value="shipping_manager"/>
    </exec>
  </target>

  <target name="stop-pasoe" description="Stop PASOE">
    <exec executable="${dlc}/bin/tcman" failonerror="true">
      <arg value="stop"/>
      <arg value="shipping_manager"/>
    </exec>
  </target>

  <target name="updatedb" description="Apply migration delta to running database">
    <exec executable="${dlc}/bin/proutil" failonerror="true">
      <arg value="shipping_manager"/>
      <arg value="-C"/>
      <arg value="updatedb"/>
      <arg value="-df"/>
      <arg value="${schema.dir}/migrations/v2.0.0.df"/>
    </exec>
  </target>

  <target name="clean" description="Remove compiled artifacts">
    <delete dir="${build.dir}"/>
  </target>

</project>
