<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
                             http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

  <display-name>shipping-manager</display-name>

  <!-- ── CORS filter ──────────────────────────────────────────────── -->
  <filter>
    <filter-name>CORSFilter</filter-name>
    <filter-class>com.progress.appserv.services.web.CORSFilter</filter-class>
    <init-param>
      <param-name>allowedOrigins</param-name>
      <!-- Comma-separated; value read from openedge.properties at startup -->
      <param-value>${shipping.cors.allowed-origins}</param-value>
    </init-param>
    <init-param>
      <param-name>allowedMethods</param-name>
      <param-value>GET,POST,PATCH,DELETE,OPTIONS</param-value>
    </init-param>
    <init-param>
      <param-name>allowedHeaders</param-name>
      <param-value>Content-Type,Authorization</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>CORSFilter</filter-name>
    <url-pattern>/api/*</url-pattern>
  </filter-mapping>

  <!-- ── Auth filter ──────────────────────────────────────────────── -->
  <filter>
    <filter-name>JwtAuthFilter</filter-name>
    <filter-class>com.progress.appserv.services.web.ABLWebAuthFilter</filter-class>
    <init-param>
      <param-name>ablClass</param-name>
      <param-value>auth.JwtAuthFilter</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>JwtAuthFilter</filter-name>
    <url-pattern>/api/v1/*</url-pattern>
  </filter-mapping>

  <!-- ── Web handler servlets ─────────────────────────────────────── -->
  <servlet>
    <servlet-name>StockLabelsHandler</servlet-name>
    <servlet-class>com.progress.appserv.services.web.ABLWebHandlerServlet</servlet-class>
    <init-param>
      <param-name>ablClass</param-name>
      <param-value>api.v1.StockLabelsHandler</param-value>
    </init-param>
  </servlet>
  <servlet-mapping>
    <servlet-name>StockLabelsHandler</servlet-name>
    <url-pattern>/api/v1/stock-labels/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LoadsHandler</servlet-name>
    <servlet-class>com.progress.appserv.services.web.ABLWebHandlerServlet</servlet-class>
    <init-param>
      <param-name>ablClass</param-name>
      <param-value>api.v1.LoadsHandler</param-value>
    </init-param>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoadsHandler</servlet-name>
    <url-pattern>/api/v1/loads/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>BinPackingHandler</servlet-name>
    <servlet-class>com.progress.appserv.services.web.ABLWebHandlerServlet</servlet-class>
    <init-param>
      <param-name>ablClass</param-name>
      <param-value>api.v1.BinPackingHandler</param-value>
    </init-param>
  </servlet>
  <servlet-mapping>
    <servlet-name>BinPackingHandler</servlet-name>
    <url-pattern>/api/v1/bin-packing/*</url-pattern>
  </servlet-mapping>

</web-app>
